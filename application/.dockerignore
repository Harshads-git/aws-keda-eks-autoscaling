# =============================================================================
# .dockerignore — Excludes files from Docker build context
# A lean build context means faster docker build and smaller layer uploads to ECR
# =============================================================================

# Python artifacts
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.egg-info/
.pytest_cache/
.coverage
htmlcov/
.tox/
.venv/
venv/

# Test files (not needed in production image)
test_*.py
tests/

# Development files
*.md
.env
.env.*
*.log

# IDE
.vscode/
.idea/
*.swp
*.swo

# Git
.git/
.gitignore
