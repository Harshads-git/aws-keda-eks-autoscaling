# =============================================================================
# aws-keda-eks-autoscaling — Environment Variables
# =============================================================================
# INSTRUCTIONS:
#   1. Copy this file: cp .env.example .env
#   2. Fill in every value marked with <REPLACE_WITH_...>
#   3. NEVER commit your .env file — it is in .gitignore
#   4. Run `bash scripts/check-prerequisites.sh` to validate your setup
# =============================================================================

# ─── AWS Core ─────────────────────────────────────────────────────────────────

# Your 12-digit AWS account ID
# Find it: aws sts get-caller-identity --query Account --output text
AWS_ACCOUNT_ID=<REPLACE_WITH_YOUR_12_DIGIT_AWS_ACCOUNT_ID>

# AWS region for all resources (keep consistent across all services)
# Recommended: us-east-1 (most Free Tier services, lowest latency to many)
AWS_REGION=us-east-1

# ─── EKS Cluster ──────────────────────────────────────────────────────────────

# Name of your EKS cluster (used in Terraform and kubectl config)
CLUSTER_NAME=keda-demo-cluster

# Kubernetes version (must match Terraform EKS module configuration)
CLUSTER_VERSION=1.29

# EKS node instance type — t3.micro is AWS Free Tier eligible
NODE_INSTANCE_TYPE=t3.micro

# Node group scaling configuration
NODE_MIN_SIZE=1
NODE_MAX_SIZE=3
NODE_DESIRED_SIZE=1

# ─── Amazon SQS ───────────────────────────────────────────────────────────────

# SQS queue name for the KEDA demo (standard queue, not FIFO)
SQS_QUEUE_NAME=keda-demo-queue

# SQS dead-letter queue name (receives messages that fail processing N times)
SQS_DLQ_NAME=keda-demo-queue-dlq

# Maximum receive count before a message is sent to DLQ (1-1000)
SQS_MAX_RECEIVE_COUNT=3

# Message visibility timeout in seconds (should be >= your processing time)
# KEDA scales based on ApproximateNumberOfMessages; set this longer than KEDA
# polling interval to prevent double-processing
SQS_VISIBILITY_TIMEOUT=30

# Full SQS queue URL — populated AFTER running scripts/setup-sqs.sh
# Format: https://sqs.<region>.amazonaws.com/<account-id>/<queue-name>
SQS_QUEUE_URL=<REPLACE_AFTER_RUNNING_setup-sqs.sh>

# Full SQS DLQ URL — populated AFTER running scripts/setup-sqs.sh
SQS_DLQ_URL=<REPLACE_AFTER_RUNNING_setup-sqs.sh>

# ─── Amazon ECR ───────────────────────────────────────────────────────────────

# ECR repository name (will be created by scripts/setup-ecr.sh)
ECR_REPO_NAME=keda-demo-app

# Full ECR repository URI — populated AFTER running scripts/setup-ecr.sh
# Format: <account-id>.dkr.ecr.<region>.amazonaws.com/<repo-name>
ECR_REPO_URI=<REPLACE_AFTER_RUNNING_setup-ecr.sh>

# Docker image tag strategy: use git SHA for traceability
# This is set automatically in CI — override locally if needed
IMAGE_TAG=latest

# ─── Kubernetes / Application ─────────────────────────────────────────────────

# Kubernetes namespace for the KEDA demo application
APP_NAMESPACE=keda-demo

# Kubernetes deployment name (must match manifests/deployment.yaml)
APP_DEPLOYMENT_NAME=keda-demo

# Kubernetes service account name (must match manifests/serviceaccount.yaml)
APP_SERVICE_ACCOUNT=keda-demo

# KEDA namespace (where KEDA operator is installed via Helm)
KEDA_NAMESPACE=keda

# KEDA service account name (for IRSA annotation)
KEDA_SERVICE_ACCOUNT=keda-operator

# ─── IRSA (IAM Roles for Service Accounts) ────────────────────────────────────

# IAM role ARN for KEDA operator (needs SQS GetQueueAttributes + CloudWatch)
# Populated AFTER running terraform apply
KEDA_IRSA_ROLE_ARN=<REPLACE_AFTER_TERRAFORM_APPLY>

# IAM role ARN for the application (needs SQS ReceiveMessage + DeleteMessage)
# Populated AFTER running terraform apply
APP_IRSA_ROLE_ARN=<REPLACE_AFTER_TERRAFORM_APPLY>

# ─── Terraform Remote State ───────────────────────────────────────────────────

# S3 bucket for Terraform state (must be globally unique)
# Suggested format: keda-demo-tfstate-<your-account-id>
TF_STATE_BUCKET=<REPLACE_WITH_UNIQUE_BUCKET_NAME>

# DynamoDB table for Terraform state locking
TF_STATE_LOCK_TABLE=keda-demo-tfstate-lock

# ─── KEDA Autoscaling Configuration ──────────────────────────────────────────

# Minimum replicas (0 = scale to zero when queue is empty)
KEDA_MIN_REPLICA_COUNT=0

# Maximum replicas KEDA can scale up to
KEDA_MAX_REPLICA_COUNT=5

# Target messages per replica (KEDA uses: desired = ceil(messages / this))
# Example: 25 messages / 5 = 5 replicas
KEDA_QUEUE_LENGTH=5

# How often KEDA checks the SQS queue depth (seconds)
KEDA_POLLING_INTERVAL=15

# How long KEDA waits after last scale event before scaling down (seconds)
KEDA_COOLDOWN_PERIOD=30

# ─── Observability ────────────────────────────────────────────────────────────

# CloudWatch log group for application logs
CLOUDWATCH_LOG_GROUP=/aws/eks/keda-demo/application

# Log retention in days
CLOUDWATCH_RETENTION_DAYS=7

# Application log level
LOG_LEVEL=INFO
