{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "description": "Prometheus data source for SmartScale AI metrics",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": "-- Grafana --",
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "description": "SmartScale AI — Service Level Objectives (SLO) & Multi-Window Multi-Burn-Rate Monitoring",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "title": "🎯 Service Level Objectives (30-Day Rolling Budget)",
      "type": "row",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "collapsed": false
    },
    {
      "title": "Availability SLI (30d Rolling)",
      "description": "Percentage of successful message processing over the last 30 days.\nSLO Target: 99.0% (Error budget = 1.0%).\nFormula: 100 * sum(processed) / (sum(processed) + sum(failed))",
      "type": "stat",
      "datasource": "${DS_PROMETHEUS}",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 98.5 },
              { "color": "green", "value": 99.0 }
            ]
          },
          "unit": "percent",
          "decimals": 3,
          "min": 90,
          "max": 100
        }
      },
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 1 },
      "targets": [
        {
          "expr": "100 * (sum(increase(keda_demo_messages_processed_total[30d])) or vector(100)) / ((sum(increase(keda_demo_messages_processed_total[30d])) + sum(increase(keda_demo_messages_failed_total[30d]))) or vector(1))",
          "legendFormat": "30d Availability",
          "refId": "A"
        }
      ]
    },
    {
      "title": "Error Budget Remaining",
      "description": "Remaining percentage of the 1% error budget.\n100% = 0 errors recorded in budget period.\n0% = Budget fully exhausted. Action: Freeze deployments, focus on reliability.\n<0% = SLO breach.",
      "type": "gauge",
      "datasource": "${DS_PROMETHEUS}",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "red", "value": 0 },
              { "color": "yellow", "value": 25 },
              { "color": "green", "value": 50 }
            ]
          },
          "unit": "percent",
          "decimals": 1,
          "min": -20,
          "max": 100
        }
      },
      "gridPos": { "h": 6, "w": 6, "x": 6, "y": 1 },
      "targets": [
        {
          "expr": "clamp_min(100 * (1 - ((sum(increase(keda_demo_messages_failed_total[30d])) or vector(0)) / (0.01 * (sum(increase(keda_demo_messages_processed_total[30d])) + sum(increase(keda_demo_messages_failed_total[30d])) + 0.001)))), -20)",
          "legendFormat": "Error Budget Left",
          "refId": "A"
        }
      ]
    },
    {
      "title": "1-Hour Burn Rate (Critical Fast Burn)",
      "description": "Rate at which the 30-day budget is being consumed over 1 hour.\n1x = Budget completely depleted in exactly 30 days.\n14.4x = 2% of budget consumed in 1h (Depletes 100% budget in 2 days).\nAlert threshold: > 14.4x fires PagerDuty/Critical notification.",
      "type": "stat",
      "datasource": "${DS_PROMETHEUS}",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 5 },
              { "color": "red", "value": 14.4 }
            ]
          },
          "unit": "none",
          "decimals": 2
        }
      },
      "gridPos": { "h": 6, "w": 6, "x": 12, "y": 1 },
      "targets": [
        {
          "expr": "((sum(rate(keda_demo_messages_failed_total[1h])) or vector(0)) / (sum(rate(keda_demo_messages_processed_total[1h])) + sum(rate(keda_demo_messages_failed_total[1h])) + 0.0001)) / 0.01",
          "legendFormat": "1h Burn Rate",
          "refId": "A"
        }
      ]
    },
    {
      "title": "6-Hour Burn Rate (Warning Slow Burn)",
      "description": "Rate at which budget is consumed over 6 hours.\n6x = 5% of error budget consumed in 6h.\nAlert threshold: > 6x fires Warning ticket.",
      "type": "stat",
      "datasource": "${DS_PROMETHEUS}",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 3 },
              { "color": "red", "value": 6 }
            ]
          },
          "unit": "none",
          "decimals": 2
        }
      },
      "gridPos": { "h": 6, "w": 6, "x": 18, "y": 1 },
      "targets": [
        {
          "expr": "((sum(rate(keda_demo_messages_failed_total[6h])) or vector(0)) / (sum(rate(keda_demo_messages_processed_total[6h])) + sum(rate(keda_demo_messages_failed_total[6h])) + 0.0001)) / 0.01",
          "legendFormat": "6h Burn Rate",
          "refId": "A"
        }
      ]
    },
    {
      "title": "🔥 Multi-Window Burn Rates Over Time",
      "type": "row",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 7 },
      "collapsed": false
    },
    {
      "title": "Burn Rate Trends (1h, 6h, 24h)",
      "description": "Comparative view of short-term vs mid-term burn rates.\nValues above horizontal alert lines indicate active budget degradation.\nShort window spikes indicate sudden outage; sustained elevations indicate progressive degradation.",
      "type": "timeseries",
      "datasource": "${DS_PROMETHEUS}",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "axisLabel": "Burn Rate Multiplier (1x = standard)",
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 2,
            "spanNulls": true
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 6 },
              { "color": "red", "value": 14.4 }
            ]
          },
          "unit": "none"
        }
      },
      "gridPos": { "h": 8, "w": 16, "x": 0, "y": 8 },
      "targets": [
        {
          "expr": "((sum(rate(keda_demo_messages_failed_total[1h])) or vector(0)) / (sum(rate(keda_demo_messages_processed_total[1h])) + sum(rate(keda_demo_messages_failed_total[1h])) + 0.0001)) / 0.01",
          "legendFormat": "1h Burn Rate (Critical threshold: 14.4x)",
          "refId": "A"
        },
        {
          "expr": "((sum(rate(keda_demo_messages_failed_total[6h])) or vector(0)) / (sum(rate(keda_demo_messages_processed_total[6h])) + sum(rate(keda_demo_messages_failed_total[6h])) + 0.0001)) / 0.01",
          "legendFormat": "6h Burn Rate (Warning threshold: 6.0x)",
          "refId": "B"
        },
        {
          "expr": "((sum(rate(keda_demo_messages_failed_total[24h])) or vector(0)) / (sum(rate(keda_demo_messages_processed_total[24h])) + sum(rate(keda_demo_messages_failed_total[24h])) + 0.0001)) / 0.01",
          "legendFormat": "24h Burn Rate (Sustained threshold: 3.0x)",
          "refId": "C"
        }
      ]
    },
    {
      "title": "SLO Burn Rate Policy",
      "type": "text",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 8 },
      "options": {
        "mode": "markdown",
        "content": "### Google SRE Alerting Matrix\n\n| Window | Burn Rate | % Budget | Severity | Action |\n|---|---|---|---|---|\n| **1h** | **14.4x** | 2% | `critical` | Page on-call immediately |\n| **6h** | **6.0x** | 5% | `warning` | File ticket, 2h response |\n| **24h**| **3.0x** | 10% | `warning` | Next business day triage |\n| **3d** | **1.0x** | 10% | `info` | Weekly review agenda |\n\n> **Error Budget:** 1.0% (99.0% Target)\n> **Measurement Window:** 30 Days rolling\n> **Formula:** `Burn Rate = (Failure Rate) / (1 - Target)`"
      }
    },
    {
      "title": "⚡ Latency SLI (P99 Processing Duration)",
      "type": "row",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 16 },
      "collapsed": false
    },
    {
      "title": "P99 Latency vs 5.0s SLO Target",
      "description": "Monitors the latency SLI: 99% of messages must be processed within 5.0 seconds.\nRed threshold line marks the contractual limit.",
      "type": "timeseries",
      "datasource": "${DS_PROMETHEUS}",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "axisLabel": "Duration (seconds)",
            "drawStyle": "line",
            "fillOpacity": 15,
            "lineWidth": 2,
            "spanNulls": true
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 3.5 },
              { "color": "red", "value": 5.0 }
            ]
          },
          "unit": "s"
        }
      },
      "gridPos": { "h": 8, "w": 16, "x": 0, "y": 17 },
      "targets": [
        {
          "expr": "histogram_quantile(0.99, sum(rate(keda_demo_message_processing_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "P99 Processing Duration",
          "refId": "A"
        },
        {
          "expr": "vector(5.0)",
          "legendFormat": "SLO Limit (5.0s)",
          "refId": "B"
        }
      ]
    },
    {
      "title": "Latency SLO Compliance %",
      "description": "Percentage of requests processed in <= 5s over the last 1 hour.\nTarget: >= 99.0%.",
      "type": "gauge",
      "datasource": "${DS_PROMETHEUS}",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 98.0 },
              { "color": "green", "value": 99.0 }
            ]
          },
          "unit": "percent",
          "decimals": 2,
          "min": 90,
          "max": 100
        }
      },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 17 },
      "targets": [
        {
          "expr": "100 * (sum(rate(keda_demo_message_processing_duration_seconds_bucket{le=\"5.0\"}[1h])) or sum(rate(keda_demo_message_processing_duration_seconds_bucket{le=\"5\"}[1h])) or vector(1)) / (sum(rate(keda_demo_message_processing_duration_seconds_count[1h])) + 0.0001)",
          "legendFormat": "Latency Compliance %",
          "refId": "A"
        }
      ]
    }
  ],
  "refresh": "10s",
  "schemaVersion": 38,
  "style": "dark",
  "tags": ["smartscale-ai", "slo", "sli", "sre", "burn-rate"],
  "time": { "from": "now-6h", "to": "now" },
  "title": "SmartScale AI — SLO & Burn Rate",
  "uid": "smartscale-slo-burn-rate",
  "version": 1
}
