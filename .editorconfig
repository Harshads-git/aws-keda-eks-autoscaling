# EditorConfig — https://editorconfig.org
# Ensures consistent formatting across editors (VSCode, IntelliJ, Vim, etc.)

root = true

# ─── Default: All Files ──────────────────────────────────────────────────────
[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
trim_trailing_whitespace = true
insert_final_newline = true

# ─── Python ──────────────────────────────────────────────────────────────────
[*.py]
indent_size = 4
max_line_length = 100

# ─── Terraform ───────────────────────────────────────────────────────────────
[*.tf]
indent_size = 2

# ─── YAML ────────────────────────────────────────────────────────────────────
[*.{yml,yaml}]
indent_size = 2

# ─── Markdown ────────────────────────────────────────────────────────────────
[*.md]
trim_trailing_whitespace = false

# ─── Shell Scripts ───────────────────────────────────────────────────────────
[*.sh]
indent_size = 2

# ─── JSON ────────────────────────────────────────────────────────────────────
[*.json]
indent_size = 2

# ─── Dockerfile ──────────────────────────────────────────────────────────────
[Dockerfile*]
indent_size = 4
